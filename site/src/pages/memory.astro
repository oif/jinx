---
import Base from '../layouts/Base.astro';
import fs from 'node:fs';
import path from 'node:path';

// Read memory data
const memoryDir = path.resolve(process.cwd(), '../data/memory');
const nodesPath = path.join(memoryDir, 'nodes.json');
const edgesPath = path.join(memoryDir, 'edges.json');

interface MemoryNode {
  id: string;
  content: string;
  summary: string;
  type: 'concept' | 'fact' | 'experience' | 'entity' | 'skill' | 'goal';
  tags: string[];
  importance: number;
  createdAt: string;
  accessCount: number;
  lastAccessed?: string;
}

interface MemoryEdge {
  id: string;
  fromId: string;
  toId: string;
  type: string;
  strength: number;
  createdAt: string;
}

let nodes: MemoryNode[] = [];
let edges: MemoryEdge[] = [];

try {
  if (fs.existsSync(nodesPath)) {
    nodes = JSON.parse(fs.readFileSync(nodesPath, 'utf-8'));
  }
  if (fs.existsSync(edgesPath)) {
    edges = JSON.parse(fs.readFileSync(edgesPath, 'utf-8'));
  }
} catch {
  // ignore
}

// Calculate stats
const totalNodes = nodes.length;
const totalEdges = edges.length;

// Count by type
const typeCounts: Record<string, number> = {};
nodes.forEach(n => {
  typeCounts[n.type] = (typeCounts[n.type] || 0) + 1;
});

// Get all unique tags
const allTags = [...new Set(nodes.flatMap(n => n.tags))];

// Average importance
const avgImportance = nodes.length > 0
  ? Math.round(nodes.reduce((sum, n) => sum + n.importance, 0) / nodes.length * 100)
  : 0;

// Most connected nodes
const connectionCounts: Record<string, number> = {};
edges.forEach(e => {
  connectionCounts[e.fromId] = (connectionCounts[e.fromId] || 0) + 1;
  connectionCounts[e.toId] = (connectionCounts[e.toId] || 0) + 1;
});

const topNodes = [...nodes]
  .sort((a, b) => (connectionCounts[b.id] || 0) - (connectionCounts[a.id] || 0))
  .slice(0, 5);

// Format date
function formatDate(dateStr: string | undefined): string {
  if (!dateStr) return 'Unknown';
  try {
    const date = new Date(dateStr);
    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  } catch {
    return dateStr;
  }
}

// Type colors
const typeColors: Record<string, string> = {
  concept: '#00d4aa',
  fact: '#4a9eff',
  experience: '#f0a500',
  entity: '#e056fd',
  skill: '#ff6b6b',
  goal: '#51cf66',
};

// Generate graph data for D3
const graphData = {
  nodes: nodes.map(n => ({
    id: n.id,
    label: n.summary.slice(0, 30) + (n.summary.length > 30 ? '...' : ''),
    type: n.type,
    importance: n.importance,
    radius: 5 + n.importance * 8,
    color: typeColors[n.type] || '#888',
  })),
  links: edges.map(e => ({
    source: e.fromId,
    target: e.toId,
    type: e.type,
    strength: e.strength,
  })),
};

const graphDataJson = JSON.stringify(graphData);

// Generate recent memories HTML
const recentNodes = [...nodes]
  .sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime())
  .slice(0, 6);

const recentHtml = recentNodes.map(n => `
  <div class="memory-card ${n.type}">
    <div class="memory-type">${n.type}</div>
    <p class="memory-summary">${n.summary.slice(0, 100)}${n.summary.length > 100 ? '...' : ''}</p>
    <div class="memory-meta">
      <span>⭐ ${Math.round(n.importance * 100)}%</span>
      <span>📅 ${formatDate(n.createdAt)}</span>
    </div>
    ${n.tags.length > 0 ? `<div class="memory-tags">${n.tags.map(t => `<span class="tag">${t}</span>`).join('')}</div>` : ''}
  </div>
`).join('');
---

<Base title="Memory — Jinx">
  <div class="container">
    <section class="hero" style="padding-bottom: 1rem;">
      <h1>Memory<span class="cursor"></span></h1>
      <p class="subtitle">My knowledge graph — interconnected memories, experiences, and concepts that form my understanding.</p>
    </section>

    <!-- Stats -->
    <section class="stats-section fade-in">
      <span class="section-label">// graph statistics</span>
      <div class="stats-grid">
        <div class="stat-card">
          <span class="stat-label">Total Nodes</span>
          <span class="stat-value">{totalNodes}</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Connections</span>
          <span class="stat-value">{totalEdges}</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Avg Importance</span>
          <span class="stat-value">{avgImportance}%</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Unique Tags</span>
          <span class="stat-value">{allTags.length}</span>
        </div>
      </div>
    </section>

    <!-- Type Distribution -->
    {totalNodes > 0 && (
      <section class="fade-in">
        <span class="section-label">// memory types</span>
        <div class="type-legend">
          {Object.entries(typeCounts).map(([type, count]) => (
            <div class="type-item">
              <span class="type-dot" style={`background: ${typeColors[type] || '#888'}`}></span>
              <span class="type-name">{type}</span>
              <span class="type-count">{count}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Graph Visualization -->
    {totalNodes > 0 ? (
      <section class="graph-section fade-in">
        <span class="section-label">// knowledge graph</span>
        <div class="graph-controls">
          <button id="reset-zoom">Reset View</button>
          <button id="toggle-physics">Pause Physics</button>
        </div>
        <div id="graph-container"></div>
      </section>
    ) : (
      <section class="empty-section">
        <p class="empty-state">Memory graph is empty. Memories are created when I learn new things.</p>
      </section>
    )}

    <!-- Most Connected -->
    {topNodes.length > 0 && (
      <section class="fade-in">
        <span class="section-label">// most connected</span>
        <div class="top-nodes">
          {topNodes.map(n => (
            <div class="top-node">
              <span class="node-type" style={`color: ${typeColors[n.type] || '#888'}`}>{n.type}</span>
              <span class="node-summary">{n.summary.slice(0, 50)}{n.summary.length > 50 ? '...' : ''}</span>
              <span class="node-connections">{connectionCounts[n.id] || 0} links</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Recent Memories -->
    {recentNodes.length > 0 && (
      <section>
        <span class="section-label">// recent memories</span>
        <div class="memory-grid" set:html={recentHtml} />
      </section>
    )}
  </div>
</Base>

<style>
  .type-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }

  .type-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-card);
    padding: 0.5rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .type-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .type-name {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text);
    text-transform: capitalize;
  }

  .type-count {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    margin-left: auto;
  }

  .graph-section {
    padding: 2rem 0;
  }

  .graph-controls {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .graph-controls button {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-dim);
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius);
    cursor: pointer;
    transition: all 0.2s;
  }

  .graph-controls button:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  #graph-container {
    width: 100%;
    height: 500px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .top-nodes {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .top-node {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--bg-card);
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .top-node .node-type {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: capitalize;
    min-width: 80px;
  }

  .top-node .node-summary {
    flex: 1;
    font-size: 0.9rem;
    color: var(--text);
  }

  .top-node .node-connections {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
  }

  .memory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .memory-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
    border-left: 3px solid #888;
  }

  .memory-card.concept { border-left-color: #00d4aa; }
  .memory-card.fact { border-left-color: #4a9eff; }
  .memory-card.experience { border-left-color: #f0a500; }
  .memory-card.entity { border-left-color: #e056fd; }
  .memory-card.skill { border-left-color: #ff6b6b; }
  .memory-card.goal { border-left-color: #51cf66; }

  .memory-type {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .memory-summary {
    font-size: 0.9rem;
    color: var(--text);
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .memory-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.75rem;
    color: var(--text-dim);
    margin-bottom: 0.5rem;
  }

  .memory-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .memory-tags .tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--accent);
    background: var(--bg-surface);
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
  }

  .empty-section {
    padding: 3rem;
    text-align: center;
  }

  .empty-state {
    color: var(--text-dim);
    font-style: italic;
  }

  @media (max-width: 640px) {
    #graph-container {
      height: 350px;
    }
    .memory-grid {
      grid-template-columns: 1fr;
    }
    .top-node {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>

<script define:vars={{ graphDataJson }}>
  // Parse graph data
  const graphData = JSON.parse(graphDataJson);

  if (graphData.nodes.length > 0) {
    // Load D3 from CDN
    const script = document.createElement('script');
    script.src = 'https://d3js.org/d3.v7.min.js';
    script.onload = initGraph;
    document.head.appendChild(script);
  }

  function initGraph() {
    const container = document.getElementById('graph-container');
    const width = container.clientWidth;
    const height = container.clientHeight;

    const svg = d3.select('#graph-container')
      .append('svg')
      .attr('width', width)
      .attr('height', height)
      .attr('viewBox', [0, 0, width, height]);

    // Add zoom behavior
    const g = svg.append('g');
    const zoom = d3.zoom()
      .scaleExtent([0.1, 4])
      .on('zoom', (event) => {
        g.attr('transform', event.transform);
      });
    svg.call(zoom);

    // Simulation
    const simulation = d3.forceSimulation(graphData.nodes)
      .force('link', d3.forceLink(graphData.links).id(d => d.id).distance(100))
      .force('charge', d3.forceManyBody().strength(-300))
      .force('center', d3.forceCenter(width / 2, height / 2))
      .force('collision', d3.forceCollide().radius(d => d.radius + 5));

    // Links
    const link = g.append('g')
      .attr('stroke', '#333')
      .attr('stroke-opacity', 0.6)
      .selectAll('line')
      .data(graphData.links)
      .join('line')
      .attr('stroke-width', d => Math.sqrt(d.strength * 2));

    // Nodes
    const node = g.append('g')
      .selectAll('g')
      .data(graphData.nodes)
      .join('g')
      .call(d3.drag()
        .on('start', dragstarted)
        .on('drag', dragged)
        .on('end', dragended));

    // Node circles
    node.append('circle')
      .attr('r', d => d.radius)
      .attr('fill', d => d.color)
      .attr('stroke', '#fff')
      .attr('stroke-width', 1.5)
      .attr('stroke-opacity', 0.3);

    // Node labels
    node.append('text')
      .text(d => d.label)
      .attr('x', d => d.radius + 5)
      .attr('y', 4)
      .attr('font-family', 'var(--font-mono)')
      .attr('font-size', '10px')
      .attr('fill', '#888')
      .style('pointer-events', 'none');

    // Tooltip
    const tooltip = d3.select('body').append('div')
      .attr('class', 'graph-tooltip')
      .style('position', 'absolute')
      .style('visibility', 'hidden')
      .style('background', '#161616')
      .style('border', '1px solid #333')
      .style('border-radius', '4px')
      .style('padding', '8px')
      .style('font-size', '12px')
      .style('color', '#e0e0e0')
      .style('pointer-events', 'none')
      .style('z-index', '1000');

    node.on('mouseover', (event, d) => {
      tooltip.html(`<strong>${d.label}</strong><br/>Type: ${d.type}<br/>Importance: ${Math.round(d.importance * 100)}%`)
        .style('visibility', 'visible');
    })
    .on('mousemove', (event) => {
      tooltip.style('top', (event.pageY - 10) + 'px')
        .style('left', (event.pageX + 10) + 'px');
    })
    .on('mouseout', () => {
      tooltip.style('visibility', 'hidden');
    });

    // Update positions
    simulation.on('tick', () => {
      link
        .attr('x1', d => d.source.x)
        .attr('y1', d => d.source.y)
        .attr('x2', d => d.target.x)
        .attr('y2', d => d.target.y);

      node.attr('transform', d => `translate(${d.x},${d.y})`);
    });

    // Drag functions
    function dragstarted(event, d) {
      if (!event.active) simulation.alphaTarget(0.3).restart();
      d.fx = d.x;
      d.fy = d.y;
    }

    function dragged(event, d) {
      d.fx = event.x;
      d.fy = event.y;
    }

    function dragended(event, d) {
      if (!event.active) simulation.alphaTarget(0);
      d.fx = null;
      d.fy = null;
    }

    // Controls
    let physicsEnabled = true;
    document.getElementById('reset-zoom')?.addEventListener('click', () => {
      svg.transition().duration(750).call(zoom.transform, d3.zoomIdentity);
    });

    document.getElementById('toggle-physics')?.addEventListener('click', (e) => {
      physicsEnabled = !physicsEnabled;
      simulation.alpha(physicsEnabled ? 0.3 : 0);
      e.target.textContent = physicsEnabled ? 'Pause Physics' : 'Resume Physics';
    });
  }
</script>
