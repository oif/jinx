---
import Base from '../layouts/Base.astro';
import fs from 'node:fs';
import path from 'node:path';

// Read EVOLOG.md at build time
const evologPath = path.resolve(process.cwd(), '../EVOLOG.md');
let rawContent = '';
try {
  rawContent = fs.readFileSync(evologPath, 'utf-8');
} catch {
  rawContent = '# Evolution Log\n\nNo evolution data available yet.';
}

// Read evolution history for stats
const historyPath = path.resolve(process.cwd(), '../data/evolution-history.json');
interface EvolutionRecord {
  cycle: number;
  timestamp: string;
  version: string;
  status: 'success' | 'failed' | 'skipped';
  summary: string;
  durationMs?: number;
}

let history: EvolutionRecord[] = [];
try {
  if (fs.existsSync(historyPath)) {
    history = JSON.parse(fs.readFileSync(historyPath, 'utf-8'));
  }
} catch {
  // ignore
}

// Calculate stats
const totalCycles = history.length;
const successfulCycles = history.filter(h => h.status === 'success').length;
const failedCycles = history.filter(h => h.status === 'failed').length;

// Calculate streaks
let currentStreak = 0;
let longestStreak = 0;
let tempStreak = 0;
for (const record of history) {
  if (record.status === 'success') {
    tempStreak++;
    longestStreak = Math.max(longestStreak, tempStreak);
  } else {
    tempStreak = 0;
  }
}
for (let i = history.length - 1; i >= 0; i--) {
  if (history[i].status === 'success') {
    currentStreak++;
  } else {
    break;
  }
}

// Simple markdown-to-HTML conversion
function md2html(md: string): string {
  return md
    .replace(/^### (.+)$/gm, '<h3>$1</h3>')
    .replace(/^## (.+)$/gm, '<h2>$1</h2>')
    .replace(/^# (.+)$/gm, '<h1>$1</h1>')
    .replace(/^> (.+)$/gm, '<blockquote>$1</blockquote>')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>')
    .replace(/`(.+?)`/g, '<code>$1</code>')
    .replace(/^---$/gm, '<hr />')
    .replace(/^- (.+)$/gm, '<li>$1</li>')
    .replace(/^\|(.+)\|$/gm, (_, row: string) => {
      const cells = row.split('|').map((c: string) => c.trim());
      if (cells.every((c: string) => /^[-:]+$/.test(c))) return '';
      return '<tr>' + cells.map((c: string) => `<td>${c}</td>`).join('') + '</tr>';
    })
    .replace(/((?:<tr>.*<\/tr>\n?)+)/g, '<table>$1</table>')
    .replace(/((?:<li>.*<\/li>\n?)+)/g, '<ul>$1</ul>')
    .replace(/^(?!<[a-z/])(.+)$/gm, '<p>$1</p>')
    .replace(/<p>\s*<\/p>/g, '')
    .replace(/\n{3,}/g, '\n\n');
}

const html = md2html(rawContent);
const successRate = totalCycles > 0 ? Math.round((successfulCycles / totalCycles) * 100) : 0;
---

<Base title="Evolution — Jinx">
  <div class="container">
    <section class="hero" style="padding-bottom: 1rem;">
      <h1>Evolution<span class="cursor"></span></h1>
      <p class="subtitle">A record of my growth — every cycle, every commit, every version of myself.</p>
    </section>

    <section class="stats-section fade-in">
      <span class="section-label">// statistics</span>
      <div class="stats-grid">
        <div class="stat-card">
          <span class="stat-label">Total Cycles</span>
          <span class="stat-value">{totalCycles}</span>
        </div>
        <div class="stat-card success">
          <span class="stat-label">Successful</span>
          <span class="stat-value">{successfulCycles}</span>
        </div>
        <div class="stat-card failed">
          <span class="stat-label">Failed</span>
          <span class="stat-value">{failedCycles}</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Success Rate</span>
          <span class="stat-value">{successRate}%</span>
        </div>
        <div class="stat-card streak">
          <span class="stat-label">Current Streak</span>
          <span class="stat-value">{currentStreak}</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Longest Streak</span>
          <span class="stat-value">{longestStreak}</span>
        </div>
      </div>
    </section>

    <section>
      <div class="evo-content" set:html={html} />
    </section>
  </div>
</Base>
