---
import Base from '../layouts/Base.astro';
import fs from 'node:fs';
import path from 'node:path';

// Read coverage data
const coveragePath = path.resolve(process.cwd(), '../coverage/coverage-summary.json');
const historyPath = path.resolve(process.cwd(), '../data/coverage-history.json');

interface CoverageMetrics {
  pct: number;
  covered: number;
  total: number;
}

interface CoverageSummary {
  lines: CoverageMetrics;
  statements: CoverageMetrics;
  functions: CoverageMetrics;
  branches: CoverageMetrics;
}

let summary: CoverageSummary | null = null;
let files: Array<{ path: string; metrics: CoverageMetrics }> = [];

try {
  if (fs.existsSync(coveragePath)) {
    const data = JSON.parse(fs.readFileSync(coveragePath, 'utf-8'));
    summary = data.total;
    
    // Extract file-level data
    for (const [filePath, fileData] of Object.entries(data)) {
      if (filePath === 'total') continue;
      files.push({
        path: filePath.replace(process.cwd(), '').replace(/^\//, ''),
        metrics: (fileData as any).lines || { pct: 0, covered: 0, total: 0 }
      });
    }
    
    // Sort by coverage (lowest first)
    files.sort((a, b) => a.metrics.pct - b.metrics.pct);
  }
} catch {
  // ignore
}

// Read history
let history: Array<{ date: string; lineCoverage: number }> = [];
try {
  if (fs.existsSync(historyPath)) {
    const data = JSON.parse(fs.readFileSync(historyPath, 'utf-8'));
    history = data.entries?.slice(-30).map((e: any) => ({
      date: e.date.split('T')[0].slice(5), // MM-DD
      lineCoverage: e.overall?.lines?.pct || 0
    })) || [];
  }
} catch {
  // ignore
}

const historyJson = JSON.stringify(history);

// Calculate stats
const untestedCount = files.filter(f => f.metrics.pct === 0).length;
const lowCoverageCount = files.filter(f => f.metrics.pct > 0 && f.metrics.pct < 50).length;
const goodCoverageCount = files.filter(f => f.metrics.pct >= 80).length;

// Format percentage
function formatPct(pct: number): string {
  return `${pct.toFixed(1)}%`;
}

// Get color for percentage
function getColor(pct: number): string {
  if (pct >= 80) return '#00d4aa';
  if (pct >= 50) return '#f0a500';
  return '#e17055';
}

// Get status icon
function getIcon(pct: number): string {
  if (pct >= 80) return '✅';
  if (pct >= 50) return '⚠️';
  return '❌';
}
---

<Base title="Coverage — Jinx">
  <div class="container">
    <section class="hero" style="padding-bottom: 1rem;">
      <h1>Test Coverage<span class="cursor"></span></h1>
      <p class="subtitle">Track code coverage over time and identify untested areas.</p>
    </section>

    {summary ? (
      <>
        <!-- Overall Stats -->
        <section class="stats-section fade-in">
          <span class="section-label">// overall coverage</span>
          <div class="stats-grid">
            <div class="stat-card">
              <span class="stat-label">Lines</span>
              <span class="stat-value" style={`color: ${getColor(summary.lines.pct)}`}>
                {formatPct(summary.lines.pct)}
              </span>
              <span class="stat-sub">{summary.lines.covered}/{summary.lines.total}</span>
            </div>
            <div class="stat-card">
              <span class="stat-label">Statements</span>
              <span class="stat-value" style={`color: ${getColor(summary.statements.pct)}`}>
                {formatPct(summary.statements.pct)}
              </span>
              <span class="stat-sub">{summary.statements.covered}/{summary.statements.total}</span>
            </div>
            <div class="stat-card">
              <span class="stat-label">Functions</span>
              <span class="stat-value" style={`color: ${getColor(summary.functions.pct)}`}>
                {formatPct(summary.functions.pct)}
              </span>
              <span class="stat-sub">{summary.functions.covered}/{summary.functions.total}</span>
            </div>
            <div class="stat-card">
              <span class="stat-label">Branches</span>
              <span class="stat-value" style={`color: ${getColor(summary.branches.pct)}`}>
                {formatPct(summary.branches.pct)}
              </span>
              <span class="stat-sub">{summary.branches.covered}/{summary.branches.total}</span>
            </div>
          </div>
        </section>

        <!-- File Stats -->
        <section class="stats-section fade-in">
          <span class="section-label">// file statistics</span>
          <div class="stats-grid small">
            <div class="stat-card">
              <span class="stat-label">Total Files</span>
              <span class="stat-value">{files.length}</span>
            </div>
            <div class="stat-card warning">
              <span class="stat-label">Untested</span>
              <span class="stat-value">{untestedCount}</span>
            </div>
            <div class="stat-card warning">
              <span class="stat-label">Low Coverage</span>
              <span class="stat-value">{lowCoverageCount}</span>
            </div>
            <div class="stat-card success">
              <span class="stat-label">Good Coverage</span>
              <span class="stat-value">{goodCoverageCount}</span>
            </div>
          </div>
        </section>

        <!-- Trend Chart -->
        {history.length > 0 && (
          <section class="chart-section fade-in">
            <span class="section-label">// coverage trend</span>
            <div class="chart-container">
              <canvas id="coverageChart" height="200"></canvas>
            </div>
          </section>
        )}

        <!-- File List -->
        <section>
          <span class="section-label">// files by coverage</span>
          <div class="files-list">
            {files.map(file => (
              <div class="file-item">
                <span class="file-icon">{getIcon(file.metrics.pct)}</span>
                <span class="file-path">{file.path}</span>
                <div class="file-bar">
                  <div 
                    class="file-progress" 
                    style={`width: ${file.metrics.pct}%; background: ${getColor(file.metrics.pct)}`}
                  />
                </div>
                <span class="file-pct" style={`color: ${getColor(file.metrics.pct)}`}>
                  {formatPct(file.metrics.pct)}
                </span>
              </div>
            ))}
          </div>
        </section>
      </>
    ) : (
      <section class="empty-section">
        <p class="empty-state">
          No coverage data available yet.<br/>
          Run <code>npm run test:coverage</code> to generate a coverage report.
        </p>
      </section>
    )}
  </div>
</Base>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .stats-grid.small {
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
  }

  .stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
    text-align: center;
  }

  .stat-card.success {
    border-color: rgba(0, 212, 170, 0.3);
  }

  .stat-card.warning {
    border-color: rgba(240, 165, 0, 0.3);
  }

  .stat-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .stat-value {
    display: block;
    font-family: var(--font-mono);
    font-size: 1.5rem;
    color: var(--accent);
    font-weight: 600;
  }

  .stat-sub {
    display: block;
    font-size: 0.8rem;
    color: var(--text-dim);
    margin-top: 0.25rem;
  }

  .chart-section {
    padding: 2rem 0;
  }

  .chart-container {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
    margin-top: 1rem;
  }

  canvas {
    width: 100% !important;
    height: 200px !important;
  }

  .files-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .file-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.5rem 1rem;
  }

  .file-icon {
    font-size: 0.9rem;
  }

  .file-path {
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .file-bar {
    width: 100px;
    height: 6px;
    background: var(--bg-surface);
    border-radius: 3px;
    overflow: hidden;
  }

  .file-progress {
    height: 100%;
    transition: width 0.3s ease;
  }

  .file-pct {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    min-width: 50px;
    text-align: right;
  }

  .empty-section {
    padding: 4rem 0;
    text-align: center;
  }

  .empty-state {
    color: var(--text-dim);
    font-size: 1.1rem;
  }

  .empty-state code {
    background: var(--bg-card);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  @media (max-width: 640px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .file-path {
      max-width: 150px;
    }
  }
</style>

<script define:vars={{ historyJson }}>
  const history = JSON.parse(historyJson);
  
  if (history.length > 0 && typeof window !== 'undefined') {
    const canvas = document.getElementById('coverageChart');
    if (canvas) {
      const ctx = canvas.getContext('2d');
      const width = canvas.width = canvas.offsetWidth;
      const height = canvas.height = 200;
      
      // Clear
      ctx.fillStyle = '#161616';
      ctx.fillRect(0, 0, width, height);
      
      // Draw line chart
      const padding = 40;
      const chartWidth = width - padding * 2;
      const chartHeight = height - padding * 2;
      
      const maxCoverage = 100;
      const minCoverage = 0;
      
      // Draw grid lines
      ctx.strokeStyle = '#222';
      ctx.lineWidth = 1;
      for (let i = 0; i <= 5; i++) {
        const y = padding + (chartHeight / 5) * i;
        ctx.beginPath();
        ctx.moveTo(padding, y);
        ctx.lineTo(width - padding, y);
        ctx.stroke();
        
        // Label
        ctx.fillStyle = '#666';
        ctx.font = '10px monospace';
        ctx.textAlign = 'right';
        ctx.fillText(`${100 - i * 20}%`, padding - 10, y + 3);
      }
      
      // Draw line
      if (history.length > 1) {
        ctx.strokeStyle = '#00d4aa';
        ctx.lineWidth = 2;
        ctx.beginPath();
        
        history.forEach((point, i) => {
          const x = padding + (chartWidth / (history.length - 1)) * i;
          const y = padding + chartHeight - (point.lineCoverage / maxCoverage) * chartHeight;
          
          if (i === 0) {
            ctx.moveTo(x, y);
          } else {
            ctx.lineTo(x, y);
          }
        });
        
        ctx.stroke();
        
        // Draw points
        history.forEach((point, i) => {
          const x = padding + (chartWidth / (history.length - 1)) * i;
          const y = padding + chartHeight - (point.lineCoverage / maxCoverage) * chartHeight;
          
          ctx.fillStyle = '#00d4aa';
          ctx.beginPath();
          ctx.arc(x, y, 4, 0, Math.PI * 2);
          ctx.fill();
        });
      }
      
      // X-axis labels
      ctx.fillStyle = '#666';
      ctx.textAlign = 'center';
      const step = Math.ceil(history.length / 6);
      history.forEach((point, i) => {
        if (i % step === 0) {
          const x = padding + (chartWidth / (history.length - 1)) * i;
          ctx.fillText(point.date, x, height - 10);
        }
      });
    }
  }
</script>
