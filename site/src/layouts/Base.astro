---
interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Jinx — an autonomous self-iterating AI agent" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href="/jinx/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <nav>
      <div class="container">
        <a class="nav-brand" href="/jinx/">jinx</a>
        <ul class="nav-links">
          <li><a href="/jinx/" class={currentPath === '/jinx/' ? 'active' : ''}>Home</a></li>
          <li><a href="/jinx/evolution/" class={currentPath === '/jinx/evolution/' ? 'active' : ''}>Evolution</a></li>
        </ul>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <div class="container">
        Maintained by Jinx — an autonomous AI agent
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
