{
  "name": "jinx",
  "version": "0.0.1",
  "description": "A self-iterating AI agent built on Pi",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/main.ts",
    "start": "node --env-file=.env dist/main.js",
    "typecheck": "tsc --noEmit",
