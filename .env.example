# Telegram
TG_BOT_TOKEN=
OWNER_ID=
# Optional: Group/Channel ID for public feedback (evolution reports, health alerts, daily briefings)
# If not set, feedback goes to OWNER_ID (private chat)
# For groups: use negative number (e.g., -1001234567890)
# For channels: use @channel_username or channel ID (e.g., -1001234567890)
FEEDBACK_CHAT_ID=
# Enable Telegram Forum Topics for organizing messages by type
# Requires: 1) FEEDBACK_CHAT_ID points to a Forum Group, 2) Bot has "Manage Topics" admin permission
# Creates topics: Announcements, Evolution, Health, Consciousness, Daily Briefing
ENABLE_TOPICS=false

# LLM — API key for ~/.pi/agent/models.json provider
ZENMUX_API_KEY=
KIMI_API_KEY=

# Default model for PI Agent (format: "provider/model-id" or just "model-id")
DEFAULT_MODEL=kimi/kimi-code

# Consciousness loop interval in minutes (default: 3)
CONSCIOUSNESS_INTERVAL_MINUTES=3

# Web Search — Exa (primary), Brave, or Serper
EXA_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
