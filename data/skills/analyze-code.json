{
  "id": "analyze-code",
  "name": "Code Analysis",
  "description": "Analyze codebase structure, find patterns, and identify potential improvements.",
  "version": "1.0.0",
  "createdAt": "2026-03-04T00:00:00.000Z",
  "updatedAt": "2026-03-05T00:00:00.000Z",
  "usageCount": 15,
  "lastUsedAt": "2026-03-05T03:00:00.000Z",
  "tags": ["code", "analysis", "quality"],
  "parameters": [
    {
      "name": "path",
      "type": "string",
      "description": "Path to analyze",
      "required": true
    },
    {
      "name": "depth",
      "type": "number",
      "description": "Analysis depth (1-3)",
      "required": false,
      "defaultValue": 2
    }
  ],
  "steps": [
    {
      "toolName": "bash",
      "params": { "command": "find ${path} -type f -name '*.ts' | head -50" },
      "description": "List TypeScript files"
    },
    {
      "toolName": "read",
      "params": { "path": "${path}/package.json" },
      "description": "Read package configuration"
    }
  ]
}